<odoo>
    <record id="view_shopify_sync_wizard_form" model="ir.ui.view">
        <field name="name">shopify.sync.wizard.form</field>
        <field name="model">shopify.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Synchronize from Shopify">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="backend_id" />
                        </h2>
                    </div>
                    <group>
                        <field name="import_products" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_sync"
                        string="Synchronize"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_sync_wizard" model="ir.actions.act_window">
        <field name="name">Synchronize from Shopify</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shopify.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="shopify_sync_wizard_menu"
        name="Syncronize"
        parent="shopify_product_sync_root_menu"
        action="action_shopify_sync_wizard"
        sequence="3"
    />
</odoo>
