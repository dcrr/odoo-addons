<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shopify_backend_connector_list_view" model="ir.ui.view">
        <field name="name">shopify.backend.connector.list.view</field>
        <field name="model">shopify.backend</field>
        <field name="arch" type="xml">
            <list string="Shopify Backends">
                <field name="name" />
                <field name="shop_name" />
            </list>
        </field>
    </record>

    <record id="shopify_backend_connector_form_view" model="ir.ui.view">
        <field name="name">shopify.backend.connector.form.view</field>
        <field name="model">shopify.backend</field>
        <field name="arch" type="xml">
            <form string="Shopify Backend">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="test_connection"
                            type="object"
                            class="oe_highlight"
                            string="Test Connection"
                            icon="fa-plug"
                        />
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field
                                name="active"
                                widget="boolean_button"
                                options="{&quot;terminology&quot;: &quot;archive&quot;}"
                            />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="shop_name" placeholder="myshop" />
                        <field
                            name="host"
                            placeholder="https://myshop.myshopify.com"
                            readonly="1"
                        />
                        <field name="api_key" />
                        <field name="api_token" password="1" />
                        <field name="api_version" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_backend_action" model="ir.actions.act_window">
        <field name="name">Shopify Backends</field>
        <field name="res_model">shopify.backend</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('shopify_backend_connector_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('shopify_backend_connector_form_view')})
            ]"
        />
    </record>

    <menuitem
        id="shopify_product_sync_root_menu"
        name="Shopify"
        web_icon="shopify_product_sync,static/description/icon.png"
        groups="connector.group_connector_manager"
        sequence="10"
    />

    <menuitem
        id="shopify_backend_menu"
        name="Backends"
        parent="shopify_product_sync_root_menu"
        action="shopify_backend_action"
        sequence="1"
    />
</odoo>
