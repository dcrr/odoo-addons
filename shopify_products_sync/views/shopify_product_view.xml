<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shopify_product_template_list_view" model="ir.ui.view">
        <field name="name">shopify.product.template.list.view</field>
        <field name="model">shopify.product.template</field>
        <field name="arch" type="xml">
            <list string="Shopify Products">
                <field name="backend_id" />
                <field name="external_id" />
                <field name="odoo_id" />
                <field name="name" optional="show" />
                <field name="list_price" optional="show" />
                <field name="sync_date" optional="show" />
            </list>
        </field>
    </record>

    <record id="shopify_product_template_form_view" model="ir.ui.view">
        <field name="name">shopify.product.template.form.view</field>
        <field name="model">shopify.product.template</field>
        <field name="arch" type="xml">
            <form string="Shopify Product">
                <sheet>
                    <group>
                        <group string="Shopify">
                            <field name="backend_id" />
                            <field name="external_id" />
                            <field name="sync_date" readonly="1" />
                        </group>
                        <group string="Odoo Product">
                            <field name="odoo_id" />
                            <field name="name" />
                            <field name="list_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Variants">
                            <field name="shopify_variant_ids" readonly="1">
                                <list>
                                    <field name="external_id" />
                                    <field name="odoo_id" />
                                    <field name="default_code" />
                                    <field name="barcode" />
                                    <field name="sync_date" />
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_product_template_action" model="ir.actions.act_window">
        <field name="name">Shopify Products</field>
        <field name="res_model">shopify.product.template</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('shopify_product_template_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('shopify_product_template_form_view')})
            ]"
        />
    </record>

    <menuitem
        id="shopify_products_root_menu"
        name="Products"
        parent="shopify_product_sync_root_menu"
        sequence="2"
    />

    <menuitem
        id="shopify_product_template_menu"
        name="Products"
        parent="shopify_products_root_menu"
        action="shopify_product_template_action"
        sequence="1"
    />

    <record id="shopify_product_product_list_view" model="ir.ui.view">
        <field name="name">shopify.product.product.list.view</field>
        <field name="model">shopify.product.product</field>
        <field name="arch" type="xml">
            <list string="Shopify Variants">
                <field name="backend_id" />
                <field name="shopify_template_id" optional="show" />
                <field name="external_id" />
                <field name="odoo_id" />
                <field name="default_code" optional="show" />
                <field name="barcode" optional="show" />
                <field name="sync_date" optional="show" />
            </list>
        </field>
    </record>

    <record id="shopify_product_product_form_view" model="ir.ui.view">
        <field name="name">shopify.product.product.form.view</field>
        <field name="model">shopify.product.product</field>
        <field name="arch" type="xml">
            <form string="Shopify Variant">
                <sheet>
                    <group>
                        <group string="Shopify">
                            <field name="backend_id" />
                            <field name="shopify_template_id" />
                            <field name="external_id" />
                            <field name="sync_date" readonly="1" />
                        </group>
                        <group string="Odoo Variant">
                            <field name="odoo_id" />
                            <field name="default_code" />
                            <field name="barcode" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_product_product_action" model="ir.actions.act_window">
        <field name="name">Shopify Variants</field>
        <field name="res_model">shopify.product.product</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('shopify_product_product_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('shopify_product_product_form_view')})
            ]"
        />
    </record>

    <menuitem
        id="shopify_product_product_menu"
        name="Variants"
        parent="shopify_products_root_menu"
        action="shopify_product_product_action"
        sequence="2"
    />
</odoo>
